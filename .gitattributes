# Normalize line endings so the build's frontmatter regex (^---\n) matches on
# every platform. Without this, core.autocrlf=true on Windows rewrites tracked
# files to CRLF on checkout and scripts/build.mjs fails with
# "SKILL.md needs frontmatter with a version".
* text=auto eol=lf
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary